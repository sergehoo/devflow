# syntax=docker/dockerfile:1
# Build du frontend React DevFlow (Vite) — PRÉPARATION, non branché sur la production.
#
# Produit frontend/dist (index.html + assets) servi par Django :
#   - /app/…            → project.views_spa.spa_index (index.html)
#   - /static/frontend/ → collectstatic (STATICFILES_DIRS « frontend »)
#
# Usage autonome (export des fichiers vers ./frontend/dist, sans image) :
#   docker build -f deploy/docker/Dockerfile.frontend --target dist --output type=local,dest=frontend/dist .
# Aucune variable secrète n'est utilisée : Vite n'expose que VITE_* (aucune requise).

FROM node:22-alpine AS build
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM scratch AS dist
COPY --from=build /build/frontend/dist/ /
